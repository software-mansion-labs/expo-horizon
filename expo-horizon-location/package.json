{
  "name": "expo-horizon-location",
  "version": "58.0.0",
  "description": "A fork of expo-location that provides two implementations: The default expo-location behavior using Google Play Services. A Meta Horizon OS compatible implementation that does not rely on Google Play Services.",
  "main": "build/index.js",
  "types": "build/index.d.ts",
  "sideEffects": false,
  "scripts": {
    "build": "expo-module build",
    "clean": "expo-module clean",
    "lint": "oxlint --config ../oxlint.config.mts . --max-warnings 0",
    "test": "expo-module test",
    "prepare": "expo-module prepare",
    "prepublishOnly": "expo-module prepublishOnly",
    "expo-module": "expo-module"
  },
  "keywords": [
    "react-native",
    "expo",
    "location",
    "geolocation",
    "coords",
    "geocoding",
    "compass",
    "horizon",
    "heading"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/software-mansion-labs/expo-horizon.git",
    "directory": "expo-horizon-location"
  },
  "bugs": {
    "url": "https://github.com/software-mansion-labs/expo-horizon/issues"
  },
  "author": "650 Industries, Inc.",
  "license": "MIT",
  "homepage": "https://www.npmjs.com/package/expo-horizon-location",
  "jest": {
    "preset": "expo-module-scripts"
  },
  "dependencies": {
    "@expo/image-utils": "^0.12.6"
  },
  "devDependencies": {
    "expo-module-scripts": "^56.0.8",
    "expo-task-manager": "~58.0.12"
  },
  "peerDependencies": {
    "expo": "*",
    "expo-horizon-core": "^58.0.0",
    "react": "*",
    "react-native": "*",
    "expo-task-manager": "*"
  },
  "exports": {
    "./app.plugin": "./app.plugin.js",
    "./app.plugin.js": "./app.plugin.js",
    "./package.json": "./package.json",
    "./plugin": "./plugin/build/index.js",
    ".": {
      "types": {
        "expo-source": "./src/index.ts",
        "default": "./build/index.d.ts"
      },
      "expo-source": "./src/index.ts",
      "default": "./build/index.js"
    },
    "./next": {
      "types": {
        "expo-source": "./src/next/index.ts",
        "default": "./build/next/index.d.ts"
      },
      "expo-source": "./src/next/index.ts",
      "default": "./build/next/index.js"
    }
  },
  "peerDependenciesMeta": {
    "expo-task-manager": {
      "optional": true
    }
  }
}
