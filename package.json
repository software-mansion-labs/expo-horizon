{
  "name": "expo-horizon-sdk",
  "private": true,
  "workspaces": [
    "example",
    "expo-horizon-core",
    "expo-horizon-location",
    "expo-horizon-notifications"
  ],
  "scripts": {
    "build": "yarn workspaces run build",
    "prepare": "yarn workspaces run prepare",
    "clean": "yarn workspaces run clean",
    "lint": "oxlint --config oxlint.config.mts . --max-warnings 0",
    "prettier:check": "prettier --check \"**/*.{ts,tsx,mts,js,jsx,json,css,scss,md}\"",
    "prettier:write": "prettier --write \"**/*.{ts,tsx,mts,js,jsx,json,css,scss,md}\"",
    "postinstall": "EXPO_NONINTERACTIVE=true yarn workspaces run build && EXPO_NONINTERACTIVE=true yarn workspaces run build plugin"
  },
  "dependencies": {
    "prettier": "^3.4.2"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "expo-module-scripts": "^56.0.5",
    "oxlint": "^1.86.0",
    "typescript": "~6.0.2"
  }
}
