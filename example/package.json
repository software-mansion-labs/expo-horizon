{
  "name": "app",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android --variant mobileDebug",
    "quest": "expo run:android --variant questDebug",
    "quest-release": "expo run:android --variant questRelease",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "clean": "rm -rf node_modules && rm -rf android && rm -rf ios",
    "postinstall": "patch-package",
    "lint": "oxlint --config ../oxlint.config.mts . --max-warnings 0",
    "ts:check": "tsc -p . --noEmit",
    "prettier:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,css,scss,md}\"",
    "prettier:write": "prettier --write \"**/*.{ts,tsx,js,jsx,json,css,scss,md}\"",
    "build": "echo 'noop'",
    "prepare": "echo 'noop'"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~58.0.2",
    "expo-build-properties": "~58.0.9",
    "expo-constants": "~58.0.9",
    "@rnrepo/build-tools": "^0.2.2",
    "@rnrepo/expo-config-plugin": "^0.3.6",
    "expo-horizon-core": "*",
    "expo-horizon-location": "*",
    "expo-horizon-notifications": "*",
    "expo-linking": "~58.0.10",
    "expo-router": "~58.0.12",
    "expo-status-bar": "~58.0.3",
    "expo-task-manager": "~58.0.11",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0-rc.3",
    "react-native-safe-area-context": "~5.9.1",
    "react-native-screens": "~4.28.0",
    "react-native-web": "~0.21.0"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@types/react": "~19.3.0",
    "patch-package": "^8.0.1",
    "postinstall-postinstall": "^2.1.0",
    "prettier": "^3.6.2",
    "tsx": "^4.20.6",
    "typescript": "~6.0.3"
  },
  "private": true
}
